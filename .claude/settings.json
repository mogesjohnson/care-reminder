{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run check:size)",
      "Bash(node scripts/check/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git config --get *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git worktree remove *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "WebFetch",
      "Edit(./.github/**)",
      "Edit(./.githooks/**)",
      "Edit(./scripts/**)",
      "Edit(./package.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.[eE][nN][vV])",
      "Read(./**/.[eE][nN][vV].*)",
      "Read(./**/*.[pP][eE][mM])",
      "Read(./**/*.[kK][eE][yY])",
      "Read(./**/*.[pP]12)",
      "Read(./**/*.[pP][fF][xX])",
      "Read(./**/[sS][eE][cC][rR][eE][tT][sS].[jJ][sS][oO][nN])",
      "Read(./**/[iI][dD]_[rR][sS][aA])",
      "Read(./**/[iI][dD]_[eE][dD]25519)",
      "Read(./**/[iI][dD]_[eE][cC][dD][sS][aA])",
      "Read(~/.ssh/**)",
      "Bash(* --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git *core.hooksPath *)",
      "Bash(git *core.hookspath *)",
      "Bash(git *core.hooksPath=*)",
      "Bash(git *core.hookspath=*)",
      "Bash(git *--unset* *core.hooksPath*)",
      "Bash(git *--unset* *core.hookspath*)",
      "Bash(git *unset *core.hooksPath*)",
      "Bash(git *unset *core.hookspath*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git * --no-index*)",
      "Bash(git show *.env*)",
      "Bash(git show *.pem*)",
      "Bash(git show *.key*)",
      "Bash(git log *.env*)",
      "Bash(git cat-file *.env*)",
      "Bash(git cat-file *.pem*)",
      "Bash(git cat-file *.key*)",
      "Bash(git diff *.env)",
      "Bash(git diff *.env *)",
      "Bash(git diff *.env.local*)",
      "Bash(git * > *)",
      "Bash(git * >*)",
      "Bash(git * 1>*)",
      "Bash(git *&>*)",
      "Bash(git *>>*)",
      "Bash(git grep *sk-*)",
      "Bash(git grep *AKIA*)",
      "Bash(git grep *ghp_*)",
      "Bash(git grep *github_pat_*)",
      "Bash(git grep *xai-*)",
      "Bash(git grep *xox*)",
      "Bash(git grep *PRIVATE KEY*)",
      "Bash(git grep *AIza*)",
      "Bash(git grep *eyJ*)",
      "Bash(git grep *api_key*)",
      "Bash(git grep *API_KEY*)",
      "Bash(git grep *--untracked*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ]
  }
}
